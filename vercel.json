{
  "rewrites": [
    { "source": "/ikis-arquitetura", "destination": "/index.html" },
    { "source": "/ikis-arquitetura/", "destination": "/index.html" },
    { "source": "/ikis", "destination": "/index.html" },
    { "source": "/ikis/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
